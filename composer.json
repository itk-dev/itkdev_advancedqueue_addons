{
    "name": "itk-dev/itkdev_advancedqueue",
    "description": "Addtional commands for Drupal's Advanced Queue module",
    "license": "EUPL-1.2",
    "type": "drupal-module",
    "authors": [
        {
            "name": "Mikkel Ricky",
            "email": "rimi@aarhus.dk"
        }
    ],
    "require": {
        "drupal/advancedqueue": "^1.7",
        "drush/drush": "^13.8"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.56",
        "palantirnet/drupal-rector": "^1.1",
        "phpstan/phpstan": "2.3.3"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "config": {
        "allow-plugins": {
            "drupal/core-composer-scaffold": true,
            "ergebnis/composer-normalize": true,
            "symfony/runtime": true
        }
    }
}
